{
  "manifest_version": 3,
  "name": "ExpireLinkX — AI Affiliate Link Guardian",
  "version": "1.0.0",
  "description": "Scan pages & YouTube channels for broken affiliate links. Detects Amazon out-of-stock, suggests AI replacements. Never lose commissions again.",

  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "notifications",
    "sidePanel"
  ],

  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },

  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
